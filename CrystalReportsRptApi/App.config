<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Substitui o appsettings.json do .NET 8 — no .NET Framework clássico a
    configuração fica aqui, lida via System.Configuration.ConfigurationManager
    (ver Services/CrystalReportsRptService.cs).

  -->
  <appSettings>
    <!-- Endereço em que o sistema abre. O padrão (localhost) só é acessível
         neste PC e não exige permissão de administrador. Para a rede, use
         http://+:5000/ (precisa do comando netsh, ver README). -->
    <add key="Endereco" value="http://localhost:5000/" />

    <!-- "false" para não abrir o navegador automaticamente ao iniciar. -->
    <add key="AbrirNavegador" value="true" />

    <!-- Limites do upload (em MB), para proteger a memória do servidor.
         O arquivo é lido inteiro na memória, então quanto menor o limite,
         mais seguro. Mantenha TamanhoMaximoArquivoMB igual (ou maior) ao
         TAMANHO_MAXIMO_ARQUIVO_MB do frontend (src/services/rptService.ts). -->
    <add key="TamanhoMaximoArquivoMB" value="30" />
    <add key="TamanhoMaximoRequisicaoMB" value="60" />
  </appSettings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

</configuration>
